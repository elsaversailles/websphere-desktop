{
  "name": "websphere-platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @websphere/api prisma:generate",
    "db:migrate": "pnpm --filter @websphere/api prisma:migrate",
    "db:seed": "pnpm --filter @websphere/api prisma:seed"
  },
  "devDependencies": { "@prisma/client": "^6.1.0", "turbo": "^2.3.3", "typescript": "^5.7.2", "prettier": "^3.4.2", "eslint": "^9.17.0", "@typescript-eslint/parser": "^8.0.0", "eslint-plugin-react-hooks": "^7.0.0" }
}
