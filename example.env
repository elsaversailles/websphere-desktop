# Copy this file to .env and supply real secrets before running backend-dependent services.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://websphere:websphere@localhost:3306/websphere
REDIS_URL=redis://localhost:6379
# Docker-only connection URLs used inside the Compose network. URL-encode any
# reserved characters in the password. Production deployment rejects localhost
# hostnames and the example credentials below.
DATABASE_URL_DOCKER=mysql://websphere:websphere@mysql:3306/websphere
REDIS_URL_DOCKER=redis://redis:6379
# These initialize a new, empty MySQL volume only. They do not rotate the
# credentials in an existing volume.
MYSQL_DATABASE=websphere
MYSQL_USER=websphere
MYSQL_PASSWORD=websphere
MYSQL_ROOT_PASSWORD=rootpassword
# Cap Node heap during each sequential server-side image build.
DOCKER_BUILD_NODE_OPTIONS=--max-old-space-size=512
JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-minimum-32-character-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=3600
CRYPTO_KEY_BASE64=replace-with-a-32-byte-base64-key
# Persistent Linux-instance directory for profile images and attachments.
# Create it with permissions for the API process, e.g. sudo install -d -o 1000 -g 1000 /var/lib/websphere/uploads
UPLOAD_DIR=/var/lib/websphere/uploads
UPLOAD_PUBLIC_PATH=/uploads
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SES_HOST=
SES_PORT=587
SES_USER=
SES_PASSWORD=
SES_FROM=noreply@example.edu
VAPID_SUBJECT=mailto:admin@example.edu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
